@model IEnumerable<Domain.Shop.ShippingAddres>
@{
    ViewData["Title"] = "ارسال با الوپیک";
}

<div class="col-12">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">انتخاب آدرس مقصد (الوپیک - فقط تهران)</h3>
        </div>

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="p-3 text-center">
                    <span class="badge bg-danger">هیچ آدرسی ثبت نشده است</span>
                    <br />
                    <a href="/UserPanel/Shop/AddAdressAloPeyk" class="btn btn-success mt-3">
                        <i class="fa fa-plus"></i> افزودن آدرس جدید
                    </a>
                </div>
            }
            else
            {
                <!-- 🖥 دسکتاپ -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>نشانی دقیق</th>
                                <th>کد پستی</th>
                                <th id="trprice" style="display:none">قیمت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var addr in Model)
                            {
                                <tr>
                                    <td>@addr.AddressLine</td>
                                    <td>@addr.PostalCode</td>
                                    <td id="sendPrice_@addr.Id" style="display:none"></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary"
                                                id="btnCalc_@addr.Id"
                                                onclick="calculateAloPeykPrice(@addr.Latitude, @addr.Longitude, @addr.Id)">
                                            محاسبه قیمت
                                        </button>

                                        <button type="button"
                                                id="btnSelect_@addr.Id"
                                                class="btn btn-success"
                                                style="display:none"
                                                onclick="selectAloPeykAddress(@addr.Id)">
                                            انتخاب
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- 📱 موبایل -->
                <div class="d-md-none p-2">
                    @foreach (var addr in Model)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@addr.province?.Title</h5>
                                <p class="mb-1"><strong>نشانی:</strong> @addr.AddressLine</p>
                                <p class="mb-1"><strong>کد پستی:</strong> @addr.PostalCode</p>

                                <button type="button"
                                        class="btn btn-primary btn-sm w-100 mt-2"
                                        id="btnCalc_M_@addr.Id"
                                        onclick="calculateAloPeykPrice(@addr.Latitude, @addr.Longitude, 'M_@addr.Id')">
                                    محاسبه قیمت
                                </button>

                                <button type="button"
                                        id="btnSelect_M_@addr.Id"
                                        class="btn btn-success btn-sm w-100 mt-2"
                                        style="display:none"
                                        onclick="selectAloPeykAddress('M_@addr.Id')">
                                    انتخاب
                                </button>

                                <div id="sendPrice_M_@addr.Id"
                                     class="mt-2 text-center fw-bold text-success"
                                     style="display:none"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- 🧾 فرم پنهان -->
        <form id="aloForm" asp-action="FinalFaktorAlopeyk"
              asp-controller="Shop" asp-area="UserPanel" method="post">
            <input type="hidden" name="addressId" id="hiddenAddressId" />
            <input type="hidden" name="price" id="hiddenPrice" />
        </form>

        <a href="/UserPanel/Shop/AddAdressAloPeyk" class="btn btn-success mt-3">
            <i class="fa fa-plus"></i> افزودن آدرس جدید
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function calculateAloPeykPrice(toLat, toLng, addrId) {
            const requestBody = {
                fromLat: 35.731768884459136,
                fromLng: 51.378562075983545,
                toLat: toLat,
                toLng: toLng,
                transportType: 'motorbike'
            };

            $.ajax({
                url: '@Url.Action("GetDeliveryPrice", "Shop", new { area = "UserPanel" })',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestBody),
                success: function (res) {
                    if (res.status === "success") {
                        const finalPrice = res.price * 10;
                        const priceText = finalPrice.toLocaleString() + ' تومان';
                        const distanceText = (res.distance / 1000).toFixed(2) + ' km';

                        // ✅ نرمال‌سازی آیدی در هر حالت
                        const numericAddrId = addrId.toString().replace('M_', '');

                        // نمایش قیمت و فاصله
                        $('#sendPrice_' + addrId)
                            .css('display', '')
                            .html(`${priceText}<br><small>${distanceText}</small>`);

                        $('#trprice').show();

                        // دکمه انتخاب را نمایش بده و قیمت را در آن ذخیره کن
                        $('#btnSelect_' + addrId)
                            .data('price', finalPrice)
                            .show();

                        // دکمه محاسبه را مخفی کن
                        $('#btnCalc_' + addrId).hide();

                        // فرم پنهان با مقدار عددی تنظیم شود
                        $('#hiddenAddressId').val(numericAddrId);
                        $('#hiddenPrice').val(finalPrice);

                        // 🔁 کلیک روی انتخاب = ارسال فرم
                        $('#btnSelect_' + addrId).off('click').on('click', function () {
                            $('#hiddenAddressId').val(numericAddrId);
                            $('#hiddenPrice').val(finalPrice);
                            $('#aloForm').submit();
                        });
                    } else {
                        alert('قیمت‌گیری از الوپیک ناموفق بود.');
                    }
                },
                error: function () {
                    alert('خطا در ارتباط با سرویس الوپیک.');
                }
            });
        }

        // تابع عمومی انتخاب، برای هر دو حالت دسکتاپ و موبایل
        function selectAloPeykAddress(addrId) {
            const price = $('#btnSelect_' + addrId).data('price');
            const numericAddrId = addrId.toString().replace('M_', ''); // عدد خالص برای فرم
            $('#hiddenAddressId').val(numericAddrId);
            $('#hiddenPrice').val(price);
            $('#aloForm').submit();
        }
    </script>
}
