@using Core.Dto.Shop.Address
@model FinalInvoiceVM

@{
    ViewData["Title"] = "پیش‌فاکتور خرید";
    var totalPrice =
  Model.Items.Sum(i => i.Quantity * i.UnitPrice / 10)
  + (Model.SendPrice );




}

<div class="col-12">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">پیش‌فاکتور ارسال با الو پیک</h3>
        </div>
        <div class="card-body p-0">

            <!-- Desktop Table -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover text-center mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>تصویر</th>
                            <th>نام محصول</th>
                            <th>تعداد</th>
                            <th>قیمت واحد (تومان)</th>
                            <th>جمع کل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5">
                                    <span class="badge bg-danger">سبد خرید شما خالی است</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <img src="@item.Product.ImageUrl" alt="@item.Product.ProductName"
                                             style="width:60px;height:60px;object-fit:cover;border-radius:5px;" />
                                    </td>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@((item.UnitPrice / 10).ToString("N0"))</td>


                                    <td>@((item.Quantity * item.UnitPrice / 10).ToString("N0"))</td>

                                </tr>
                            }

                            <tr id="discountRow" class="d-none text-danger fw-bold">
                                <td colspan="4">مبلغ تخفیف</td>
                                <td>
                                    <span id="discountValue">0</span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4">
                                    هزینه ارسال به آدرس (@Model.Address.AddressLine)
                                </td>
                                <td>     @((Model.SendPrice ).ToString("N0")) </td>
                            </tr>
                            <tr id="discountRow" class="d-none text-danger fw-bold">
                                <td colspan="4">مبلغ تخفیف</td>
                                <td>
                                    <span id="discountValue">0</span>
                                </td>
                            </tr>
                            <tr class="table-info fw-bold">
                                <td colspan="4">مجموع</td>
                                <td>
                                    <span class="js-totalPrice text-primary"
                                          data-original="@totalPrice">
                                        @totalPrice.ToString("N0")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="d-md-none p-2">
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <span class="badge bg-danger">سبد خرید شما خالی است</span>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body text-center">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.ProductName"
                                     class="mb-2" style="width:80px;height:80px;object-fit:cover;border-radius:5px;" />
                                <h5 class="card-title fw-bold">@item.Product.ProductName</h5>
                                <p class="mb-1">تعداد: @item.Quantity</p>
                                <p class="mb-1">قیمت واحد: @((item.UnitPrice / 10).ToString("N0"))</p>
                                <p class="text-success fw-bold">جمع کل: @((item.Quantity * item.UnitPrice / 10).ToString("N0"))</p>
                            </div>
                        </div>
                    }
                    <div class="card p-3 bg-light">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>هزینه ارسال:</span>
                            <span class="text-primary">
                                @((Model.SendPrice / 10).ToString("N0"))
                            </span>
                        </div>
                    </div>
                    <div id="discountRow" class="card p-3 bg-light d-none">
                        <div class="d-flex justify-content-between fw-bold text-danger">
                            <span>مبلغ تخفیف:</span>
                            <span id="discountValue">0</span>
                        </div>
                    </div>

                    <div class="card p-3 bg-light">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>مجموع پرداختی:</span>


                            <span class="js-totalPrice text-primary"
                                  data-original="@totalPrice">
                                @totalPrice.ToString("N0") تومان
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="p-3 border-top">

            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <input id="discountCode"
                           class="form-control"
                           placeholder="کد تخفیف" />
                </div>

                <div class="col-12 col-md-3">
                    <button id="btnApplyDiscount"
                            type="button"
                            class="btn btn-primary w-100">
                        اعمال کد
                    </button>
                </div>

                <div class="col-12 col-md-3">
                    <small id="discountMessage"
                           class="d-none"></small>
                </div>
            </div>

        </div>

        <!-- دکمه ادامه -->
        <div class="card-footer text-center">
            <a id="btnPay" asp-action="AddtoOrder" asp-controller="shop" asp-area="UserPanel" asp-route-AddressId="@Model.Address.Id" asp-route-sendprice="@Model.SendPrice"
               class="btn btn-success btn-lg px-4 fw-bold">
                <i class="fa fa-credit-card"></i> پرداخت
            </a>
        </div>
    </div>
</div>
@section Scripts {
    <script>

                let appliedDiscountCode = null;


        document.getElementById("btnPay")
            .addEventListener("click", function () {

                if (!appliedDiscountCode)
                    return;

                const url = new URL(this.href);

                url.searchParams.set("code", appliedDiscountCode);

                this.href = url.toString();
            });



        document.getElementById("btnApplyDiscount")
            .addEventListener("click", function () {

                const code = document.getElementById("discountCode").value;
                const msg = document.getElementById("discountMessage");

                if (!code) {
                    msg.className = "text-danger";
                    msg.innerText = "کد تخفیف را وارد کنید";
                    msg.classList.remove("d-none");
                    return;
                }

                fetch('@Url.Action("CheckDiscountCode", "Shop")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: new URLSearchParams({ code })
                })
                .then(r => r.json())
                .then(data => {
                    msg.classList.remove("d-none");

                    if (!data.success) {
                        msg.className = "text-danger";
                        msg.innerText = data.message;
                        return;
                    }

                    msg.className = "text-success";
                    msg.innerText = `کد تخفیف اعمال شد (${data.percent}٪)`;
                    appliedDiscountCode = code;
                    applyDiscountToView(data.percent);
                });
            });

               function applyDiscountToView(percent) {

            let discountAmount = 0;

            document.querySelectorAll(".js-totalPrice")
                .forEach(totalEl => {

                    const original = Number(totalEl.dataset.original);
                    if (isNaN(original)) return;

                    discountAmount = Math.floor(original * percent / 100);
                    const final = original - discountAmount;

                    totalEl.innerText =
                        final.toLocaleString('fa-IR') +
                        (totalEl.innerText.includes("تومان") ? " تومان" : "");
                });

            const discountRow = document.getElementById("discountRow");
            if (discountRow)
                discountRow.classList.remove("d-none");

            const discountValue = document.getElementById("discountValue");
            if (discountValue)
                discountValue.innerText =
                    discountAmount.toLocaleString('fa-IR');
        }



    </script>

}