@using Core.Dto.Shop.Address
@using Domain.Shop
@model GetAddressOfUserVM

<div class="col-12">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">انتخاب آدرس ارسال</h3>
        </div>
        <div class="card-body p-0">

            @if (Model.OldAddress != null && Model.OldAddress.Any())
            {
                <!-- Desktop Table -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>آدرس کامل</th>
                                <th>کد پستی</th>
                                <th>انتخاب</th>
                            </tr>
                        </thead>
                        <tbody id="addressesListDesktop">
                            @foreach (var addr in Model.OldAddress)
                            {
                                <tr>
                                    <td>@addr.AddressLine</td>
                                    <td>@addr.PostalCode</td>
                                    <td>
                                        <a asp-action="FinalFaktor"
                                           asp-controller="Shop"
                                           asp-area="UserPanel"
                                           asp-route-AddressId="@addr.Id"
                                           class="btn btn-success btn-sm">انتخاب</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div id="addressesListMobile" class="d-md-none p-2">
                    @foreach (var addr in Model.OldAddress)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <p class="mb-1"><i class="fa fa-map-marker-alt"></i> آدرس: @addr.AddressLine</p>
                                <p class="mb-1"><i class="fa fa-mail-bulk"></i> کدپستی: @addr.PostalCode</p>
                                <a class="btn btn-success btn-sm mt-2 w-100"
                                   asp-action="FinalFaktor"
                                   asp-controller="Shop"
                                   asp-area="UserPanel" asp-route-AddressId="@addr.Id">
                                    انتخاب این آدرس
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center my-3">
                    <button id="showNewAddressFormBtn" class="btn btn-primary">افزودن آدرس جدید</button>
                </div>
            }
            else
            {
                <div class="p-3">
                    <span class="badge bg-danger">هیچ آدرسی ثبت نشده است</span>
                </div>
                <div class="text-center my-3">
                    <button id="showNewAddressFormBtn" class="btn btn-primary">افزودن آدرس جدید</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- فرم آدرس جدید -->
