@using Core.Dto.Shop.Address
@using Domain.Shop
@model GetAddressOfUserVM
@{
    ViewData["Title"] = "UserAddress";
}

<div class="col-12">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">انتخاب آدرس ارسال</h3>
        </div>
        <div class="card-body p-0">

            @if (Model.OldAddress != null && Model.OldAddress.Any())
            {
                <!-- Desktop Table -->
                <div class="table-responsive d-none d-md-block">
                    <table class="table table-hover text-center mb-0">
                        <thead class="table-dark">
                            <tr>
                               
                            
                                <th>آدرس کامل</th>
                                <th>کد پستی</th>
                                <th>انتخاب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var addr in Model.OldAddress)
                            {
                                <tr>

                                    <td>@addr.AddressLine</td>
                                    <td>@addr.PostalCode</td>
                                    <td>
                                        <a asp-action="FinalFaktor" asp-controller="Shop" asp-area="UserPanel" asp-route-AddressId="@addr.Id" class="btn btn-success btn-sm">
                              
                                            انتخاب
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-md-none p-2">
                    @foreach (var addr in Model.OldAddress)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <p class="mb-1"><i class="fa fa-mail-bulk"></i> کدپستی: @addr.AddressLine</p>
                                <p class="mb-1"><i class="fa fa-mail-bulk"></i> کدپستی: @addr.PostalCode</p>
                                <button class="btn btn-success btn-sm mt-2 w-100"
                                        onclick="selectAddress('@addr.Id')">
                                    انتخاب این آدرس
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center my-3">
                    <button id="showNewAddressFormBtn">افزودن آدرس جدید</button>

                </div>
            }
            else
            {
                <!-- اگر آدرس وجود ندارد -->
                <div class="p-3">
                    <span class="badge bg-danger">هیچ آدرسی ثبت نشده است</span>
                </div>
                <div class="text-center my-3">
                    <button id="showNewAddressFormBtn">افزودن آدرس جدید</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- فرم آدرس جدید - پیش‌فرض مخفی -->
<div id="newAddressForm" class="mt-4 @(Model.ShowNewAddressForm ? "" : "d-none")">
    <div id="newAddressFormWrapper" style="display:none;">
        @Html.Partial("_NewAddressForm", new ShippingAddres())
    </div>
</div>
<div id="newAddressMessages"></div>
@section Scripts{
    <script>
            $(document).ready(function () {
            // نمایش فرم افزودن آدرس
            $("#showNewAddressFormBtn").on("click", function () {
            $("#newAddressForm").removeClass("d-none");
                $("#newAddressFormWrapper").slideDown();
            });

            // ارسال فرم با AJAX
            $(document).on("submit", "#newAddressFormAjax", function (e) {
                e.preventDefault();

                $.ajax({
                    url: '/UserPanel/Shop/AddCity',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) {
                            $("#newAddressMessages").html("<p style='color:green'>آدرس با موفقیت ثبت شد.</p>");

                            // بستن فرم و پاک کردن فیلدها
                            $("#newAddressFormAjax")[0].reset();
                            $("#newAddressFormWrapper").slideUp();

                            // افزودن به لیست آدرس‌ها بدون رفرش
                            $(".addresses-list").append(
                                `<div class="address-card">
                                    <p>${res.newAddress.AddressLine}</p>
                                    <p>${res.newAddress.PostalCode}</p>
                                </div>`
                            );

                        } else {
                            // نمایش خطاها
                            let errorHtml = "<ul style='color:red'>";
                            for (let field in res.errors) {
                                res.errors[field].forEach(msg => {
                                    errorHtml += `<li>${msg}</li>`;
                                });
                            }
                            errorHtml += "</ul>";
                            $("#newAddressMessages").html(errorHtml);
                        }
                    },
                    error: function () {
                        $("#newAddressMessages").html("<p style='color:red'>خطا در ارسال درخواست.</p>");
                    }
                });
            });
        });



    </script>

    <script>
        function selectAddress(id) {
            console.log("✅ آدرس انتخاب شد:", id);
            // اینجا می‌تونی به مرحله انتخاب روش ارسال و محاسبه هزینه هدایت کنی
        }
        function showNewAddressForm() {
            document.getElementById('newAddressForm').classList.remove('d-none');
            window.scrollTo({ top: document.getElementById('newAddressForm').offsetTop, behavior: 'smooth' });
        }
    </script>
}

