@model IEnumerable<Domain.Shop.PostPrice>
@{
    ViewData["Title"] = "اعلان ها";
}


<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"> لیست قیمت ها</h3>
        </div>
        <div class="card-body">
            <p>
                <a class="btn btn-success" asp-action="Add">جدید</a>
            </p>
            <form asp-action="index">
            <div class="row">
              
                <div class="col-md-5">
                    <select name="provicesId" asp-items="ViewBag.Providce" class="form-control"></select>
                </div>
                <div class="col-md-2">
                    <input type="submit" class="btn btn-primary" value="جستجو" />

                </div>
          
            </div>
            </form>
            <table class="table table-responsive table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.province.Title)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Weight)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Price)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.province.Title)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Weight)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                <a class="btn btn-info" asp-action="Edit" asp-route-PriceId="@item.Id">ویرایش</a>
                                <a asp-action="Delete" asp-route-PriceId="@item.Id" onclick="return confirm('ایا از حذف اطمینان دارید؟')" class="btn btn-danger"> حذف</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
