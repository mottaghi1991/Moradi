@using Core.Dto.ViewModel.main
@using Core.Extention
@using Domain
@using Domain.Shop

@model Paging<Order>
@{
    ViewData["Title"] = "Index";
}

<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"> لیست سفارشات</h3>
        </div>
        <div class="card-body">
            <form method="get">
                <div class="row">
                    <div class="col-md-3">
                        <input type="text" name="fullName" value="@Model.fullName" class="form-control" placeholder="نام کاربر" />
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="mobile" value="@Model.mobile" class="form-control" placeholder="شماره موبایل" />
                    </div>
                    <div class="col-md-3">
                        @Html.DropDownListFor(m => m.paymentStatus, new List<SelectListItem>
                        {
                            new SelectListItem { Value = "", Text = "همه وضعیت‌ها" },
                                                new SelectListItem { Value = ((int)OrderStatus.Pending).ToString(), Text = "پرداخت نشده" },
                                                new SelectListItem { Value = ((int)OrderStatus.Paid).ToString(), Text = "پرداخت شده" },
                                                new SelectListItem { Value = ((int)OrderStatus.Shipped).ToString(), Text = "ارسال شده" },
                                                new SelectListItem { Value = ((int)OrderStatus.Delivered).ToString(), Text = "تحویل شده" },
                                                new SelectListItem { Value = ((int)OrderStatus.Cancelled).ToString(), Text = "لغو شده" }
                                                }, new { @class = "form-control" })
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary" type="submit">جستجو</button>
                    </div>
                </div>
            </form>
            <table class="table table-responsive table-hover">
                <thead>
                    <tr>
                        <th>
                            شماره سفارش
                        </th>
                        <th>@Html.DisplayNameFor(model => model.bjects.First().User.FullName)</th>
                        <th>@Html.DisplayNameFor(model => model.bjects.First().User.UserName)</th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().SendPrice)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().TotalAmount)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().PaymentDate)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().DeliveryMethod)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().ShippingAddress.AddressLine)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.bjects.First().Status)
                        </th>
                      
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.bjects)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td>@item.User.FullName</td>
                            <td>@item.User.UserName</td>
                            <td>
                                @((item.SendPrice / 10).ToString("N0"))
                            </td>
                            <td>
                                @((item.TotalAmount / 10).ToString("N0"))
                            </td>
                            <td>
                                @(item.PaymentDate.HasValue? item.PaymentDate.Value.ToPersian():"")

                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ShippingAddress.province.Title)
                            </td>
                            <td>
                            @if (item.DeliveryMethod == DeliveryMethod.Post)
                            {
                                <label>پست</label>
                            }else if (item.DeliveryMethod == DeliveryMethod.AloPeyk)
                            {
                                <label>الو پیک</label>
                            }
                            </td>
                            <td>
                                @if (item.Status == OrderStatus.Pending)
                                {
                                    <label class="badge badge-danger">در انتظار پرداخت</label>

                                }
                                else if (item.Status == OrderStatus.Paid)
                                {
                                    <label class="badge badge-warning">پرداخت شده</label>
                                }
                                else if (item.Status == OrderStatus.Shipped)
                                {
                                    <label class="badge badge-success">ارسال شده</label>

                                }

                            </td>
                            <td>
                                <a class="badge btn-warning" asp-route-OrderId="@item.Id" asp-action="orderdetail">جزئیات سفارش</a>
                            </td>
                            <td>
                             
                                @if (item.Status == OrderStatus.Shipped)
                                {
                                    <a class="badge btn-primary" asp-action="sendPostOrder" asp-route-OrderId="@item.Id">ارسال شده</a>

                                }
                                @if (item.Status == OrderStatus.Paid )
                                {
                                    <a class="badge btn-danger" asp-action="sendPostOrder" asp-route-OrderId="@item.Id">ارسال مرسوله</a>

                                }
                                @if (item.Status == OrderStatus.Delivered)
                                {
                                    <a class="badge btn-success">تحویل شده</a>

                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Pagination -->
@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.pageSize);
}

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <!-- Previous -->
            <li class="page-item @(Model.pageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new {
                    pageNumber = Model.pageNumber - 1,
                    pageSize = Model.pageSize,
                    userId = Model.userId,
                    fullName = Model.fullName,
                    mobile = Model.mobile,
                    paymentStatus = Model.paymentStatus
                })">قبلی</a>
            </li>

            <!-- Numbers -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.pageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        pageNumber = i,
                        pageSize = Model.pageSize,
                        userId = Model.userId,
                        fullName = Model.fullName,
                        mobile = Model.mobile,
                        paymentStatus = Model.paymentStatus
                    })">@i</a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.pageNumber == totalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new {
                    pageNumber = Model.pageNumber + 1,
                    pageSize = Model.pageSize,
                    userId = Model.userId,
                    fullName = Model.fullName,
                    mobile = Model.mobile,
                    paymentStatus = Model.paymentStatus
                })">بعدی</a>
            </li>
        </ul>
    </nav>
}
