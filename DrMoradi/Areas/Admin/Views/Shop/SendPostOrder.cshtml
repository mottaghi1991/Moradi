@using Core.Dto.Shop.Order
@model OrderSendPostVm
@{
    ViewData["Title"] = "SendPostOrder";
}

<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">اطلاعات ارسال مرسوله</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <form asp-action="SendPostOrder" id="myform">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <label asp-for="SendDate" class="control-label"></label>
                            <input name="SendDate" id="txtDate" value="@Model.SendDate" class="form-control" />
                            <span asp-validation-for="SendDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PostIdentity" class="control-label"></label>
                            <input asp-for="PostIdentity" class="form-control" />
                            <span asp-validation-for="PostIdentity" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="ثبت" class="btn btn-info" />


                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


@section Scripts
{
    <script>
        kamaDatepicker('txtDate', {
            nextButtonIcon: "fa fa-arrow-circle-right",
            previousButtonIcon: "fa fa-arrow-circle-left",
            forceFarsiDigits: true,     // نمایش اعداد فارسی
            markToday: true,            // مشخص‌کردن امروز
            highlightSelectedDay: true, // رنگ زدن روز انتخاب‌شده
            sync: true,                 // ثبت مقدار انتخاب‌شده داخل input
            gotoToday: true             // دکمهٔ رفتن به امروز
        });
    </script>

}