@using Domain.Shop
@model Order

@{
    ViewData["Title"] = "پیش‌فاکتور خرید";
}

<div class="col-12">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">‌</h3>
        </div>
        <div class="card-body p-0">

            <!-- Desktop Table -->
            <div class="table d-none d-md-block">
                <table class="table-hover text-center mb-0" style="width:100%">
                    <thead class="table-dark">
                        <tr>
                            <th>تصویر</th>
                            <th>نام محصول</th>
                            <th>تعداد</th>
                            <th>قیمت واحد (تومان)</th>
                            <th>جمع کل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.OrderItems == null || !Model.OrderItems.Any())
                        {
                            <tr>
                                <td colspan="5">
                                    <span class="badge bg-danger">سبد خرید شما خالی است</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <img src="@item.Product.ImageUrl" alt="@item.Product.ProductName"
                                             style="width:60px;height:60px;object-fit:cover;border-radius:5px;" />
                                    </td>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>@((item.UnitPrice / 10).ToString("N0"))</td>
                                    <td>@((item.Quantity * (item.UnitPrice / 10)).ToString("N0"))</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="4">
                                    آدرس
                                </td>
                                <td>     @Model.ShippingAddress.AddressLine </td>
                            </tr>
                            <tr>
                                <td colspan="4">
                                    هزینه ارسال
                                </td>
                                <td>     @((Model.SendPrice / 10).ToString("N0")) </td>
                            </tr>
                            <tr class="table-info fw-bold">
                                <td colspan="4">مجموع</td>
                                <td>
                                    @((Model.OrderItems.Sum(i => i.Quantity * (i.UnitPrice / 10)) + (Model.SendPrice / 10)).ToString("N0"))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="d-md-none p-2">
                @if (Model.OrderItems == null || !Model.OrderItems.Any())
                {
                    <span class="badge bg-danger">سبد خرید شما خالی است</span>
                }
                else
                {
                    foreach (var item in Model.OrderItems)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body text-center">
                                <img src="@item.Product.ImageUrl" alt="@item.Product.ProductName"
                                     class="mb-2" style="width:80px;height:80px;object-fit:cover;border-radius:5px;" />
                                <h5 class="card-title fw-bold">@item.Product.ProductName</h5>
                                <p class="mb-1">تعداد: @item.Quantity</p>
                                <p class="mb-1">قیمت واحد: @item.UnitPrice.ToString("N0")</p>
                                <p class="text-success fw-bold">جمع کل: @((item.Quantity * item.UnitPrice).ToString("N0"))</p>
                            </div>
                        </div>
                    }
                    <div class="card p-3 bg-light">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>هزینه ارسال:</span>
                            <span class="text-primary">
                                @((Model.SendPrice / 10).ToString("N0"))
                            </span>
                        </div>
                    </div>
                    <div class="card p-3 bg-light">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>آدرس</span>
                            <span class="text-primary">
                                @Model.ShippingAddress.AddressLine
                            </span>
                        </div>
                    </div>
                    <div class="card p-3 bg-light">
                        <div class="d-flex justify-content-between fw-bold">
                            <span>مجموع پرداختی:</span>
                            <span class="text-primary">
                                @((Model.OrderItems.Sum(i => i.Quantity * i.UnitPrice) + (Model.SendPrice / 10)).ToString("N0")) تومان
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
