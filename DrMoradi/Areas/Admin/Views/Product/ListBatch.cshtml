@model Core.Dto.Shop.Batch.BatchListVm
@using Core.Extention;
@{
    ViewData["Title"] = "ListBatch";
}

<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"> لیست سفارشات</h3>
        </div>
        <div class="card-body">
            <a asp-action="AddBatch" class="btn badge-success" asp-route-ProductId="@Model.ProductId">جدید</a>
            <table class="table table-responsive table-hover">
                <thead>
                    <tr>
                       
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().Product.ProductName)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().Price)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().Stock)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().Sold)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().Remain)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().OffPricePercent)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().IsActive)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Batches.FirstOrDefault().CreateDate)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Batches)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Product.ProductName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Stock)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Sold)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Remain)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.OffPricePercent)


                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsActive)
                            </td>
                            <td>
                                @item.CreateDate.ToPersian()
                            </td>
                            <td ><a class="btn btn-primary" asp-action="EditBatch" asp-route-BatchId="@item.Id">ویرایش</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
