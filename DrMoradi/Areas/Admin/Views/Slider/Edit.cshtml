@using Core.Dto.ViewModel.main
@model SliderEditVm
@{
    ViewData["Title"] = "Edit";
}

<div class="col-md-12">
    <div class="card card-info">
        <div class="card-header">
            <h3 class="card-title">ویرایش دسته بندی</h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data" id="myform">
            <div class="row">
                <div class=" col-lg-6 col-md-12">
                   
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <label asp-for="DesktopFile" class="control-label"></label>
                            <input asp-for="DesktopFileImage" class="form-control" type="file"/>
                            <span asp-validation-for="DesktopFile" class="text-danger"></span>
                        </div>
                    </div>
                    <div class=" col-lg-6 col-md-12">
                        <div class="form-group">

                            <label asp-for="DesktopDescript" class="control-label"></label>
                            <input asp-for="DesktopDescript" class="form-control">
                            <span asp-validation-for="DesktopDescript" class="text-danger"></span>

                        </div>

                    
                  
          </div>
            </div>
                <div class="row">
                    <div class=" col-lg-6 col-md-12">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <label asp-for="MobileFile" class="control-label"></label>
                            <input asp-for="MobileFileImage" class="form-control" type="file" />
                            <span asp-validation-for="MobileFile" class="text-danger"></span>
                        </div>
                    </div>
                    <div class=" col-lg-6 col-md-12">
                        <div class="form-group">

                            <label asp-for="MobileDescript" class="control-label"></label>
                            <input asp-for="MobileDescript" class="form-control">
                            <span asp-validation-for="MobileDescript" class="text-danger"></span>

                        </div>



                    </div>
                </div>
                <div class=" col-lg-6 col-md-12">
                    <div class="form-group">

                        <label asp-for="Link" class="control-label"></label>
                        <input asp-for="Link" class="form-control" style="direction:ltr">
                        <span asp-validation-for="Link" class="text-danger" ></span>

                    </div>



                </div>
                <div class="form-group">
                    <input type="submit" value="ثبت" class="btn btn-info" />


                </div>
            </form>
        </div>

    </div>
</div>


