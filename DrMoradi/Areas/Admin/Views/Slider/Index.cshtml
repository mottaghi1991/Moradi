@model IEnumerable<Domain.Dr.Slider>
@{
    ViewData["Title"] = "Index";
}

<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"> لیست تصاویر</h3>
        </div>
        <div class="card-body">
        
            <table class="table table-responsive table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.DesktopFile)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.MobileFile)
                        </th>
                   
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                     <img src="@item.DesktopFile" style="width:50px"/>
                            </td>

                            <td>
                                <img src="@item.MobileFile" style="width:50px" />

                            </td>
                            <td>
                                <a class="btn btn-info" asp-action="Edit" asp-route-SliderId="@item.Id">ویرایش</a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
