@using Core.Dto.ViewModel.Dr
@model ShowUserFormVM

@{
    ViewData["Title"] = "UserForm";
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">لیست سفارشات</h3>
    </div>
    <div class="card-body">

        @* دکمه‌ها *@
        @{
            var index = 0;
        }
        @foreach (var item in Model.userDiets)
        {
            if (index == 0)
            {
                <a href="#" class="btn btn-primary load-form" data-id="@item.Id">فرم اولیه</a>
            }
            else
            {
                <a href="#" class="btn btn-info load-form" data-id="@item.Id">فرم ثانویه</a>
            }
            index++;
        }

        <hr />

        @* بخش لود اولیه با دیتا پیش‌فرض *@
        <div id="user-form-container">
            <partial name="_UserFormDetails" model="Model" />
        </div>

        <a class="btn btn-info mt-3" asp-action="Index" asp-controller="DietOrder">بازگشت به لیست</a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.load-form', function (e) {
            e.preventDefault();

            var userDietId = $(this).data('id');
            var url = '@Url.Action("LoadUserFormDetails", "DietOrder","Admin")';

            // لودر موقت
            $('#user-form-container').html('<div class="text-center p-3">در حال بارگذاری...</div>');

            $.get(url, { UserDietId: userDietId })
                .done(function (data) {
                    $('#user-form-container').html(data);
                })
                .fail(function () {
                    $('#user-form-container').html('<div class="alert alert-danger">خطا در بارگذاری اطلاعات کاربر</div>');
                });
        });
    </script>
}
