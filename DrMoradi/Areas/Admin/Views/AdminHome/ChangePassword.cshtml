@using Core.Dto.ViewModel.User
@model RegisterViewModel
@{
    ViewData["Title"] = "ChangePassword";
}


<div class="col-md-12 m-3">
    <div class="card card-success">
        <div class="card-header">
            <h3 class="card-title">@Model.UserName </h3>
        </div>
        <div class="card-body">
            <div class="row ">
                <div class="col-lg-12 col-md-4">
                    <form asp-action="ChangePassword">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="UserName" />


                        <div class="form-group">
                            <label asp-for="PassWord" class="control-label"></label>
                            <input asp-for="PassWord" class="form-control" type="password"/>
                            <span asp-validation-for="PassWord" class="text-danger"></span>

                        </div>
                        <div class="form-group">
                            <label asp-for="RePassword" class="control-label"></label>
                            <input asp-for="RePassword" class="form-control" type="password" >
                            <span asp-validation-for="RePassword" class="text-danger"></span>

                        </div>


                        <div class="form-group">
                            <input type="submit" value="ثبت" class="btn btn-success" />

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

