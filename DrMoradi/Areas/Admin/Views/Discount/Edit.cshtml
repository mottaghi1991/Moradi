@model Domain.Shop.Discount

@{
    ViewData["Title"] = "ویرایش تخفیف";
}

<div class="col-md-12">
    <div class="card card-success">
        <div class="card-header">
            <h3 class="card-title">تخفیف جدید </h3>
        </div>
        <div class="card-body">
            <div class="row">

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                 <input type="hidden" asp-for="Id" />
                    <div class="col-lg-12 col-md-4">
                        <div class="form-group">
                            <label asp-for="Percent" class="control-label"></label>
                            <input asp-for="Percent" class="form-control">
                            <span asp-validation-for="Percent" class="text-danger"></span>

                        </div>

                    </div>
                    <div class="col-lg-12 col-md-4">
                        <div class="form-group">
                            <label asp-for="IsDeleted" class="control-label"></label>
                            <input asp-for="IsDeleted" class="form-control">
                            <span asp-validation-for="IsDeleted" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="ثبت" class="btn btn-success" />

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


