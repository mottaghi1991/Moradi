@model Domain.Shop.Discount
@{
    ViewData["Title"] = "ایجاد تخفیف";
}

<div class="col-md-12">
    <div class="card card-success">
        <div class="card-header">
            <h3 class="card-title">تخفیف جدید </h3>
        </div>
        <div class="card-body">
            <div class="row">

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-lg-12 col-md-4">

                        <div class="form-group">
                            <label asp-for="UserId" class="control-label"></label>
                            <select asp-for="UserId" class="form-control myselect" asp-items="ViewBag.UserId">
                                <option value="0">لطفا شخص مورد نظر را انتخاب نمائید .</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger"></span>

                        </div>
                    </div>
                    <div class="col-lg-12 col-md-4">
                    <div class="form-group">
                        <label asp-for="Percent" class="control-label"></label>
                        <input asp-for="Percent" class="form-control">
                        <span asp-validation-for="Percent" class="text-danger"></span>

                    </div>

                    </div>
                    <div class="form-group">
                        <input type="submit" value="ثبت" class="btn btn-success" />

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


