@model IEnumerable<Domain.Shop.Discount>
@{
    ViewData["Title"] = "تخفیف";
}

<div class="col-md-12">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"> لیست گروه ها</h3>
        </div>
        <div class="card-body">
      
                <form asp-controller="Discount" asp-action="Create" method="post">
                    <div class="row g-2 align-items-center">

                        <div class="col-auto">
                            <input name="Percent" class="form-control" placeholder="درصد">
                        </div>

                        <div class="col-auto">
                            <input type="submit" value="ایجاد" class="btn btn-success">
                        </div>

                    </div>
                </form>
      
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <table class="table table-responsive table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Code)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Percent)
                        </th>
                      
                        <th>
                            @Html.DisplayNameFor(model => model.OrderId)
                        </th>
                       
                        <th>
                            @Html.DisplayNameFor(model => model.UsedTime)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsUsed)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IsDeleted)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Code)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Percent)
                            </td>
                           
                            <td>
                                @Html.DisplayFor(modelItem => item.OrderId)
                            </td>
                          
                            <td>
                                @if (item.UsedTime != default(DateTime))
                                {
                                    @item.UsedTime.ToShortDateString()

                                }
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsUsed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsDeleted)
                            </td>
                            <td>
                                <a class="btn btn-info" asp-action="Edit" asp-route-DiscountId="@item.Id">ویرایش</a>
                                @if(!item.IsDeleted)
                                {
                                    <a class="btn btn-danger" asp-action="delete" asp-route-DiscountId="@item.Id" onclick="return confirm('ایا از حذف اطمینان دارید؟')">حذف</a>

                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


