@model IEnumerable<Domain.Shop.Product>
@{
    ViewData["Title"] = "محصولات";
}
@section style{
    <style>
        .unstyled-link {
            all: unset; /* همه استایل‌های ارث‌بری و پیش‌فرض مرورگر رو پاک می‌کنه */
            cursor: pointer; /* چون all: unset اینو هم حذف می‌کنه، دوباره ستش می‌کنیم */
        }

    </style>
}
<div class="container mt-4">

    <form method="get" asp-action="Index" asp-controller="Shop">
        <div class="row justify-content-center text-center">
            <!-- فیلتر دسته‌بندی -->
            <div class="col-md-3">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">همه دسته‌ها</option>
                
                </select>
            </div>

            <!-- فیلتر ارزان‌ترین -->
            <div class="col-md-3">
                <select name="sort" class="form-select">
                    <option value="">مرتب‌سازی پیش‌فرض</option>
                    <option value="cheap">ارزان‌ترین</option>
                    <option value="expensive">گران ‌ترین</option>
                </select>
            </div>

            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">جستجو</button>
            </div>
        </div>
        </form>


    <div class="row justify-content-center text-center">
        @foreach (var item in Model)
        {
            var activePrice = (item.ProductBatches.FirstOrDefault(b => b.IsActive)?.Price ?? 0) / 10;
            <div class="col-md-3">
                <div class="card mt-4">
                    <div style="border:none">
                        <a class="unstyled-link" asp-action="ProductDetail" asp-route-ProductId="@item.Id"><img src="@item.ImageUrl" class="img-fluid" style="border-radius:50px;width:250px;max-width:100%;height:auto" alt="@item.ProductName"></a>
                    </div>
                    <!-- بخش متن و دکمه -->
                    <div class="card-body">
                        <h5 class="text-center"><a class="unstyled-link" asp-action="ProductDetail" asp-route-ProductId="@item.Id">@item.ProductName</a></h5>
                        <p class="plan-price text-center">
                        @(activePrice > 0 ? activePrice.ToString("N0") : "ناموجود")
                        </div>
                </div>
            </div>
        }
    </div>
</div>

