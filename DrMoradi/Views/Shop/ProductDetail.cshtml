@using Domain
@model Core.Dto.ViewModel.Store.ProductDto.ShowProductDetailVm
@{
    ViewData["Title"] = "ProductDetail";
}

@section style {
    <style>
        .product-image-main {
            border-radius: 10px;
            overflow: hidden;
        }

        .thumbnail-images img {
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 8px;
        }

            .thumbnail-images img.active {
                border-color: #0d6efd;
            }

        .price {
            color: #0d6efd;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .carousel-control-prev {
            right: 0;
            left: auto;
        }

        .carousel-control-next {
            left: 0;
            right: auto;
        }

        .shadow-strong {
            box-shadow: 0 8px 20px rgba(0,0,0,0.15); /* سایه نرم و عمیق */
            border-radius: 10px;
        }

            .shadow-strong:hover {
                box-shadow: 0 10px 28px rgba(0,0,0,0.18); /* افکت hover برای جلوه بهتر */
            }
    </style>
}
<div class="container  my-5">
    <div class="row m-4 align-items-stretch">

        <!-- بخش تصویر محصول -->
        <div class="col-lg-6 product-column shadow-strong d-flex flex-column">
            <div id="productCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <!-- تصویر اصلی (اول) -->
                    <div class="carousel-item active">
                        <img src="@Model.ImageUrl" class="d-block w-100" alt="کینوا">
                    </div>

                    @if (Model.productImages.Any())
                    {
                        foreach (var item in Model.productImages)
                        {
                            <div class="carousel-item">
                                <img src="@item.ImageUrl" class="d-block w-100" alt="کینوا">
                            </div>
                        }
                    }
                </div>

                <!-- دکمه "عقب" -->
                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <!-- دکمه "جلو" -->
                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

            <!-- تصاویر کوچک (Thumbnails) -->
            <div class="d-flex justify-content-center gap-2 mt-3 thumbnail-images">
                <img src="@Model.ImageUrl" data-bs-slide-to="0" class="active" width="80" alt="">
                @{
                    int index = 1;
                    if (Model.productImages.Any())
                    {
                        foreach (var item in Model.productImages)
                        {
                            <img src="@item.ImageUrl" data-bs-slide-to="@index" width="80" alt="">
                            index++;
                        }
                    }
                }
            </div>
        </div>

        <!-- بخش اطلاعات محصول -->
        <div class="col-lg-6 product-column  p-4 rounded shadow-strong d-flex flex-column ml-3">
            <h4 class="mb-3">@Model.ProductName</h4>
            <div class="price mb-2">@((Model.Price / 10).ToString("N0")) تومان</div>
            <div class="mb-3">
                <span class="text-warning">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <span class="text-muted">(0 نظر)</span>
            </div>

            <h6 class="fw-bold">توضیحات محصول:</h6>
            <p style="text-align: justify; font-size: 0.9rem;">
                @Html.Raw(Model.Attrib)
            </p>

            <!-- انتخاب تعداد -->
            <div class="d-flex align-items-center mb-3">
                <label class="me-2 mb-0" id="max">تعداد موجودی (@Model.Stock عدد):</label>
                <div class="input-group w-auto">
                    <button class="btn btn-danger" type="button" id="decrease">-</button>
                    <input type="number" class="form-control text-center" id="quantity" value="1" min="1"
                           max="@Model.Stock" style="width:70px;">
                    <button class="btn btn-success" type="button" id="increase">+</button>
                </div>
            </div>

            <!-- دکمه ها -->
            <div class="d-flex gap-2">
                <button class="btn btn-primary flex-fill" data-product-id="@Model.Id"
                        data-quantity="1">
                    افزودن به سبد خرید
                </button>
            </div>
        </div>

    </div>
</div>
@if(Model.Video!=null)
{
    <div class="row justify-content-center">
        <div class="col-12 col-md-6">
            <div class="ratio ratio-16x9">
                @Html.Raw(Model.Video)
                @*     <iframe src="https://www.aparat.com/video/video/embed/videohash/sg0oe/vt/frame"
                    allowfullscreen
                    webkitallowfullscreen
                    mozallowfullscreen>
            </iframe> *@
            </div>
        </div>
    </div>
}

<div class="container">
    @await Component.InvokeAsync("ProductComponent")
</div>
<div class="row m-4">
    <div class="container-fluid d-flex justify-content-center align-items-center">
        <div class="col-12">
            <div class="bg-light p-3 rounded shadow-sm mb-3">
                <div class="fw-bold mb-3">ثبت نظر</div>
                @if (User.Identity.IsAuthenticated)
                {
                    <form id="commentForm">
                        <label class="label">نظر دهید</label>
                        <textarea name="message" class="form-control" rows="6" required oninvalid="this.setCustomValidity('لطفاً پیام خود را وارد کنید')"
                                  oninput="this.setCustomValidity('')"></textarea>
                        <input type="hidden" name="Id" value="@Model.Id" />
                        <input type="hidden" name="type" value="@((int)EntityType.Product)" />
                        <input type="submit" class="btn btn-outline-success mt-3" value="ثبت" />

                    </form>
                    <div id="resultMessage" class="mt-3" style="display:none;"></div>
                }
                else
                {
                    <label class="badge badge-danger">
                        برای ثبت نظر یا پاسخ وارد پنل کاربری شوید
                        <a href="/SmsLogin" class="btn btn-success">ورود</a>
                    </label>
                }
                <div class="container-fluid mt-4">
                    <div class="bg-light p-3 rounded shadow-sm mb-3">
                        <div class="fw-bold mb-3">نظرات</div>

                        <!-- یک نظر -->
                        <!-- نظر اصلی -->
                        @await Component.InvokeAsync("InsertComment", new { entityId = Model.Id, entityType = EntityType.Product })



                    </div>
                </div>

            </div>
        </div>
    </div>
</div>





@section Scripts {

    <script>
        $(document).ready(function () {
            $("#commentForm").on("submit", function (e) {
                e.preventDefault(); // نذاره فرم عادی ارسال بشه

                // جلوگیری از ارسال در صورت نامعتبر بودن
                if (!this.checkValidity()) {
                    this.reportValidity();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SubmitComment", "Home")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (res) {
                        $("#resultMessage")
                            .removeClass()
                            .addClass(res.success ? "alert alert-success" : "alert alert-danger")
                            .text(res.message)
                            .fadeIn();

                        if (res.success) {
                            $("#commentForm")[0].reset(); // پاک کردن فرم
                        }
                    },
                    error: function () {
                        $("#resultMessage")
                            .removeClass()
                            .addClass("alert alert-danger")
                            .text("مشکلی در ارسال فرم رخ داد")
                            .fadeIn();
                    }
                });
            });
        });
    </script>



    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const carouselElement = document.querySelector('#productCarousel');
            const carousel = new bootstrap.Carousel(carouselElement);
            const thumbnails = document.querySelectorAll('.thumbnail-images img');

            // وقتی روی thumbnail کلیک بشه → اسلاید تغییر کنه
            thumbnails.forEach((thumb, index) => {
                thumb.addEventListener('click', () => {
                    carousel.to(index);
                });
            });

            // وقتی اسلاید عوض می‌شه → active thumbnail عوض بشه
            carouselElement.addEventListener('slide.bs.carousel', function (event) {
                thumbnails.forEach(t => t.classList.remove('active'));
                thumbnails[event.to].classList.add('active');
            });
        });
    </script>
}
