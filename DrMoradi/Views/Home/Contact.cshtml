@using Core.Dto.ViewModel.main
@model ShowContactUsVM
@{
    ViewData["Title"] = "Contact";
}
@section style {
    <style>
        /* کارت‌های آدرس و شماره تماس ارتفاع بیشتری داشته باشن */
        .contact-card-tall {
            min-height: 120px; /* یا هر مقدار دلخواه */
            display: flex;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

            /* تغییر رنگ در هاور */
            .contact-card-tall:hover {
                background-color: #0d6efd; /* آبی بوت‌استرپ */
                color: #fff; /* متن سفید برای خوانایی */
            }

                /* مطمئن بشیم متن و لینک هم سفید میشه */
                .contact-card-tall:hover h6,
                .contact-card-tall:hover p,
                .contact-card-tall:hover a,
                .contact-card-tall:hover i {
                    color: #fff !important;
                }


        .faq-section {
            max-width: 800px;
            margin: 4rem auto;
            background: #fff;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 2rem;
        }

        .faq-title {
            text-align: center;
            margin-bottom: 2rem;
        }

            .faq-title h2 {
                font-weight: 700;
                color: #444;
            }

        .accordion-button {
            background-color: #fefcf9;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .accordion-button:not(.collapsed) {
                color: #000;
                background-color: #f4d28a40;
                box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
            }

            .accordion-button:focus {
                box-shadow: 0 0 0 0.2rem rgba(244,210,138,0.4);
            }

            .accordion-button strong {
                color: #a6772b; /* طلایی ملایم هم‌تم */
                font-weight: 700; /* ضخیم‌تر از متن سؤال */
                font-size: 1.05rem;
                margin-left: 6px;
            }

        .accordion-item {
            border: none;
            border-bottom: 1px solid #eee;
        }

        .accordion-body {
            background: #fffdf5;
            line-height: 1.8;
            color: #555;
        }

            .accordion-body .text-muted {
                font-style: italic; /* حالت ملایم‌تر و متفاوت */
                color: #956c29; /* سایه طلایی تیره‌تر برای تم یک‌دست */
                font-weight: 500;
                margin-right: 4px;
            }

            .accordion-body p {
                background: #fff8e4;
                border-radius: 8px;
                padding: 8px 12px;
                margin-bottom: 10px;
                transition: background-color 0.3s ease;
            }

                .accordion-body p:hover {
                    background: #f4d28a50;
                }
        /* بخش افزودن سوال */
        .ask-box {
            margin-top: 3rem;
            padding: 1.5rem;
            background: #fffbea;
            border-radius: 10px;
            text-align: center;
        }

            .ask-box h5 {
                font-weight: 600;
                margin-bottom: 1rem;
                color: #555;
            }

            .ask-box input, .ask-box textarea {
                border-radius: 8px;
                border: 1px solid #ddd;
                transition: all .2s;
            }

                .ask-box input:focus, .ask-box textarea:focus {
                    border-color: #f4d28a;
                    box-shadow: 0 0 0 0.2rem rgba(244,210,138,0.25);
                }

        .btn-send {
            background-color: #f4d28a;
            border: none;
            color: #333;
            font-weight: 600;
            transition: all .3s;
        }

            .btn-send:hover {
                background-color: #f1c86c;
                color: #000;
            }

    </style>


}
<section class="position-relative py-5 " style="background-color: #f8f9fa;">
    <div class="container">
        <div class="row my-4 justify-content-center">
            <div class="col-12">
                <div class="section-title text-center">
                    <h3 class="sub-title mb-4">
                        ارتباط با ما

                    </h3>
                    <ul class="list-unstyled mt-4">
                        <li class="list-inline-item user text-muted ms-3">
                            <i class="mdi mdi-eye"></i>
                            <span>صفحه اصلی</span>
                        </li>
                        <li class="list-inline-item date text-muted">
                            <i class="mdi mdi-calendar-check"></i>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="pt-5">
    <!-- اگر کل صفحه RTL است، می‌توانید این را بردارید -->

    <div class="container py-5">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6 d-flex" id="commentComponentWrapper">
                <!-- ستون راست: فرم و اسلایدر -->
                @await Component.InvokeAsync("CommentComponent")
                <!-- باکس BMI -->


            </div>
            <div class="col-lg-6">
                <!-- آدرس مطب -->
                <div class="card mb-3 shadow-sm border-0 contact-card-tall">
                    <div class="card-body d-flex align-items-center">
                        <div class="ms-3 text-primary fs-3">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">آدرس مطب</h6>
                            <p class="mb-0 text-muted">
                                @Model.Setting.Address
                            </p>
                        </div>
                    </div>
                </div>

                <!-- شماره تماس -->
                <div class="card mb-3 shadow-sm border-0 contact-card-tall">
                    <div class="card-body d-flex align-items-center">
                        <div class="ms-3 text-primary fs-3">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">شماره تماس</h6>
                            <p class="mb-0">
                                <a href="tel:@Model.Setting.Number1" class="text-decoration-none text-dark">@Model.Setting.Number1</a>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- نقشه گوگل -->
                <div class="card shadow-sm border-0">
                    <div class="ratio ratio-16x9">


                        <iframe src="@Model.Setting.MapAddress" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>


        </div>
    </div>


</section>

<div class="faq-section">
    <div class="faq-title">
        <h2>سؤالاتی که کاربران پرسیده اند</h2>
    </div>

    <!-- Accordion -->

    <div class="accordion" id="faqAccordion">
        @foreach (var item in Model.comments.Where(c => c.ParentId == null))
        {
            var headerId = $"q{item.Id}";
            var collapseId = $"a{item.Id}";
            var replies = Model.comments.Where(a => a.ParentId == item.Id).ToList();

            <div class="accordion-item">
                <h2 class="accordion-header" id="@headerId">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#@collapseId"
                            aria-expanded="false"
                            aria-controls="@collapseId">
                        <strong>@item.Name:</strong>&nbsp; @item.Text
                    </button>
                </h2>

                <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headerId">
                    <div class="accordion-body">
                        @if (replies.Any())
                        {
                            @foreach (var reply in replies)
                            {
                                <p>
                                    <strong>پاسخ:</strong> @reply.Text
                                    <span class="text-muted"> @reply.Name</span>
                                </p>
                            }
                        }
                        else
                        {
                            <p class="text-muted">هنوز پاسخی برای این سؤال ثبت نشده است.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>


</div>


@section Scripts {
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/jquery.validate.unobtrusive.min.js"></script>
    <script>
        $(document).on("submit", "#mobileForm", function(e) {

            e.preventDefault(); // جلوگیری از سابمیت عادی
            var $form = $(this);
            $.ajax({
                url: $form.attr("action"),
                method: "POST",
                data: $form.serialize(),
                success: function (result) {

                      $("#commentComponentWrapper").html(result);
        if ($.validator && $.validator.unobtrusive)
            $.validator.unobtrusive.parse("#mobileForm");

        if ($("#successMessage").length) {
            setTimeout(function () {
                $("#successMessage").fadeOut(600);
            }, 4000);
        }
        if ($("#errorMessage").length) {
            setTimeout(function () {
                $("#errorMessage").fadeOut(600);
            }, 4000);
        }
        if ($('#testimonialsCarousel').length)
            $('#testimonialsCarousel').carousel();
                },
                error: function () {
                    alert("مشکل در ارتباط با سرور. لطفا بعدا تلاش کنید.");
                }
            });
        });
    </script>
}