@model IEnumerable<Domain.Shop.Category>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var index = 0;
}
<div class="card" style="border:none;background-color:#F9F9F9">
    <div class="card-header" style="border:none;background-color:#F9F9F9">
        <h3 class="fw-bold text-start">دسته بندی محصولات</h3>
    </div>
    <div class="card-body">
        <div class="swiper mySwiper">
            <div class="swiper-wrapper">
                @foreach(var item in Model)
                {
                    <div class="swiper-slide">

                        <div class="card" style="background-color:#F8F9FC;">
                            <div class="card-header p-0" style="border:none; overflow:hidden; background:none;">
                                <a asp-controller="Shop" asp-route-categoryId="@item.Id" ><img src="@item.Image"
                                     style="width:300px;max-width:100%; display:block; height:auto; border-radius:0;"
                                     alt="@item.CategoryName" loading="lazy"></a>
                            </div>
                            <div class="card-body">
                                <a asp-controller="Shop" asp-route-categoryId="@item.Id" style="text-decoration:none" >
                                    <h5 class="text-center card-title-fixed">@item.CategoryName</h5></a>
                                <a asp-controller="shop" asp-route-categoryId="@item.Id" class="plan-btn">لیست محصولات</a>
                            </div>
                        </div>

                    </div>
                }
           
           
              
            
        
            

            </div>
            <!-- دکمه‌های ناوبری -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <!-- نقاط -->
            <div class="swiper-pagination"></div>
        </div>

    </div>
</div>