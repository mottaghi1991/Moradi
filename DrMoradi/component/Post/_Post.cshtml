@using Core.Dto.ViewModel.WP

@model IEnumerable<WordPressPost>

<div class="card-body">
    <div class="swiper mySwiper1">
        <div class="swiper-wrapper">
            @foreach(var item in Model)
            {
                <div class="swiper-slide">
                    <div class="card shadow-sm h-100 d-flex flex-column">
                        <img src="@item.Image" class="card-img-top" alt="@item.Title.Rendered"
                             style="height:200px;object-fit:cover;" loading="lazy" />
                        <div class="card-body d-flex flex-column flex-grow-1" style="height:350px;">
                            <h5 class="card-title">@Html.Raw(item.Title.Rendered)</h5>
                            <p class="card-text flex-grow-1">@Html.Raw(item.Excerpt.Rendered)</p>
                             <a href="@item.Link"
                   class="btn btn-outline-primary mt-auto align-self-start">
                    ادامه مطلب
                </a>
                        </div>
                    </div>
                </div>
            }
       
     
       


        </div>
        <!-- دکمه‌های ناوبری -->
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
        <!-- نقاط -->
        <div class="swiper-pagination" style="padding:10px"></div>
    </div>
    <div class="row justify-content-center mt-3">
        <div class="col-md-1 d-flex justify-content-center">
            <a href="\Blogs" class="plan-btn w-100">مشاهده همه</a>
        </div>
    </div>
</div>