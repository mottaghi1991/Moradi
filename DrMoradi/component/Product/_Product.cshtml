@model IEnumerable<Domain.Shop.Product>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<section class="pt-5">

    <div class="card" style="border:none;background-color:white;">
        <div class="card-header" style="background-color:white;border:none">
            <h3 class="fw-bold text-center plan-price">محصولات پیشنهادی دکتر معصومه مرادی</h3>
            <h6 class="fw-bold text-center plan-price">با انتخاب هر محصول، توضیحات مربوط به آن را مطالعه کنید.</h6>

        </div>
        <div class="card-body">
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    @foreach (var item in Model)
                    {
                        var activePrice = (item.ProductBatches.FirstOrDefault(b => b.IsActive)?.Price ?? 0) / 10;

                        <div class="swiper-slide">
                            <div class="card" style="background-color:#F9F9F9;border:none">
                                <div class="card-header" style="border:none;background-color:#F9F9F9">
                                    <a asp-action="ProductDetail" asp-area="" asp-controller="Shop" asp-route-ProductId="@item.Id">      <img src="@item.ImageUrl" class="img-fluid" style="border-radius:50px;width:250px;max-width:100%;height:auto" alt="@item.ProductName"></a>
                                </div>
                                <!-- بخش متن و دکمه -->
                                <div class="card-body">
                                    <a asp-action="ProductDetail" asp-area="" asp-controller="Shop" asp-route-ProductId="@item.Id"><h5 class="text-center card-title-fixed">@item.ProductName</h5></a>
                                    <p class="plan-price text-center">
                                 @*        <span>
                                            @(
                                                item.ProductBatches.FirstOrDefault()?.Price != null
                                                ? (item.ProductBatches.FirstOrDefault().Price / 10).ToString("N0")  // یا فقط .ToString()
                                                : "-"
                                                )
                                        </span> تومان *@
                                    </p>
                                    <a asp-action="ProductDetail" asp-area="" asp-controller="Shop" asp-route-ProductId="@item.Id" class="plan-btn" style="background-color:#506180">      @(activePrice > 0 ? activePrice.ToString("N0") : "ناموجود")</a>
                                    @* <a asp-action="NotFound" asp-area="" asp-controller="Home" asp-route-DietId="@item.Id" class="plan-btn" style="background-color:#506180">ثبت سفارش</a> *@
                                </div>
                            </div>
                        </div>
                    }



                </div>
                <!-- دکمه‌های ناوبری -->
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
                <!-- نقاط -->
                <div class="swiper-pagination"></div>
            </div>
            <div class="row justify-content-center mt-3">
                <div class="col-md-1 d-flex justify-content-center">
                    <a href="\Diets" class="plan-btn w-100">مشاهده همه</a>
                </div>
            </div>



        </div>
    </div>
</section>